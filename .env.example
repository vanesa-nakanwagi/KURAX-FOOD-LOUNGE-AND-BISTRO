# Local PostgreSQL configuration
POSTGRES_DB=kurax_db
POSTGRES_USER=kurax
POSTGRES_PASSWORD=generate-a-long-random-password
DB_PORT=5432

# Backend application configuration
PORT=5010
DATABASE_URL=postgresql://kurax:generate-a-long-random-password@127.0.0.1:5432/kurax_db
# Temporary direct Neon connection URL used only for the one-time import.
NEON_DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_USER=
EMAIL_PASS=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
BACKEND_PORT=5010
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MENU_IMAGE_BUCKET=menu-images

# Frontend/browser configuration
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
FRONTEND_PORT=8080

# Keep Firebase private admin credentials on the backend only.
# Keep SUPABASE_SERVICE_ROLE_KEY server-only; never use a VITE_ prefix or expose it to the browser.
# Do not store real secrets in Git.
# Leave VITE_API_URL blank when Nginx proxies /api on the same origin; set only an origin when using a separate API host.
