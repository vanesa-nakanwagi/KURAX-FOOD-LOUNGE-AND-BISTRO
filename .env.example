# PostgreSQL container configuration
POSTGRES_DB=kurax_db
POSTGRES_USER=kurax
POSTGRES_PASSWORD=change_me_strong_password
DB_PORT=5432

# Backend application configuration
PORT=5010
DATABASE_URL=postgresql://kurax:change_me_strong_password@database:5432/kurax_db
JWT_SECRET=replace-with-a-long-random-secret
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
BACKEND_PORT=5010

# Frontend/browser configuration
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
FRONTEND_PORT=8080

# Notes:
# - Keep Firebase private admin credentials on the backend only.
# - Do not store real secrets in Git.
# - Leave VITE_API_URL blank when Nginx proxies /api on the same origin; set only an origin when using a separate API host.
